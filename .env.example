# LLM — default Groq for free-tier prototyping
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional fallback / preferred for /automatic-drawing and vision screenshots
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
VISUAL_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1

# Web grounding and learner-visible citations (server only)
TAVILY_API_KEY=

# Live cloud browser for /browser (Browserbase). Optional — local Playwright Chromium works without this.
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Optional public origin override
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub App for /data-flow “Connect GitHub” (Contents: Read, Metadata: Read)
# Setup / callback URL: {APP_ORIGIN}/api/data-flow/github/callback
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=

# Optional Groq vision model (used when OPENAI_API_KEY is unset)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional: Python binary for /ai-tutor (defaults to python3)
# PYTHON_PATH=python3

# AI Tutor v2 FastAPI service (used by /ai-tutor-v2 through Next proxies)
# AI_TUTOR_V2_URL=http://127.0.0.1:8000

# @seethrough/debug — local request/error collector (on by default in `next dev`)
# SEETHROUGH_DEBUG=1
# SEETHROUGH_DEBUG_PORT=4319
# SEETHROUGH_DEBUG_PROJECT=seethrough

# Voice
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_STT_MODEL=nova-2

# Token compression (Pipe A/B). Default on. Set to 0 to disable.
TOKEN_COMPRESSION_ENABLED=1

# Independent job judge on live ship_short. Default OFF (week one: eval/gold only).
# Enable only after human agreement on all 17 A gold rows (ship-short vs failure note).
# TOKEN_COMPRESSION_RUNTIME_JOB_JUDGE=1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin console at /seethrough-admin (defaults to "password" if unset)
SEETHROUGH_ADMIN_PASSWORD=
