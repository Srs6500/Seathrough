# AI Tutor v2 only. Copy to ai-tutor-v2/.env. Do not commit that file.
# Process environment wins. Missing keys are filled from this file, then the repo-root .env.

AI_TUTOR_V2_DATABASE_URL=postgresql+asyncpg://ai_tutor_v2:ai_tutor_v2@127.0.0.1:5435/ai_tutor_v2
AI_TUTOR_V2_PLANNER=fake
AI_TUTOR_V2_CORS_ORIGINS=http://localhost:3000

# Shared model credentials. The existing tutor reads the same names from the repo-root .env.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

AI_TUTOR_V2_MODEL_TIMEOUT_S=25
AI_TUTOR_V2_MODEL_MAX_TOKENS=1200
AI_TUTOR_V2_LESSON_TOKEN_BUDGET=6000
AI_TUTOR_V2_MAX_BEATS=6
AI_TUTOR_V2_TOOL_TIMEOUT_S=2
AI_TUTOR_V2_RATE_LIMIT_PER_MINUTE=20
AI_TUTOR_V2_MAX_BODY_BYTES=32768
AI_TUTOR_V2_HEARTBEAT_INTERVAL_S=15
AI_TUTOR_V2_DATABASE_CONNECT_TIMEOUT_S=5
