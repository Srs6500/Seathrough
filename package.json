{
  "name": "visual-education",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:debug": "npm install --prefix packages/debug --include=dev && npm run build --prefix packages/debug",
    "prebuild": "npm run build:debug",
    "predev": "npm run build:debug",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "backend": "bash backend/run.sh",
    "backend:check": "bash backend/run.sh --check",
    "backend:test": "bash backend/run.sh --self-test",
    "ingest:svgs": "node scripts/ingest-svgs.cjs",
    "fetch:diagrams": "node scripts/fetch-external-diagrams.cjs",
    "ingest:diagrams": "node scripts/ingest-diagrams.cjs",
    "fetch:jsxgraph-share": "node scripts/fetch-jsxgraph-share.cjs",
    "ingest:jsxgraph": "node scripts/ingest-jsxgraph-catalog.cjs",
    "smoke:jsxgraph-catalog": "node scripts/smoke-jsxgraph-catalog.cjs",
    "smoke:diagrams": "node scripts/smoke-diagrams.cjs",
    "smoke:visual-library": "npx --yes esbuild scripts/smoke-visual-library.ts --bundle --platform=node --outfile=/tmp/smoke-vl.js && node /tmp/smoke-vl.js",
    "smoke:anatomy": "npx --yes esbuild scripts/smoke-anatomy.ts --bundle --platform=node --outfile=/tmp/smoke-anatomy.js && node /tmp/smoke-anatomy.js",
    "smoke:leetcode": "npx --yes esbuild scripts/smoke-leetcode.ts --bundle --platform=node --outfile=/tmp/smoke-leetcode.js && node /tmp/smoke-leetcode.js",
    "smoke:image-explain": "npx --yes esbuild scripts/smoke-image-explain.ts --bundle --platform=node --outfile=/tmp/smoke-image-explain.js && node /tmp/smoke-image-explain.js",
    "smoke:modes": "npx --yes esbuild scripts/smoke-modes.ts --bundle --platform=node --outfile=/tmp/smoke-modes.js && node /tmp/smoke-modes.js",
    "smoke:physics-tutor": "npx --yes esbuild scripts/smoke-physics-tutor.ts --bundle --platform=node --outfile=/tmp/smoke-physics-tutor.js && node /tmp/smoke-physics-tutor.js",
    "smoke:physics-speech": "npx --yes esbuild scripts/smoke-physics-speech.ts --bundle --platform=node --external:temml --external:speech-rule-engine --outfile=/tmp/smoke-physics-speech.js && node /tmp/smoke-physics-speech.js",
    "smoke:dynamic-math-speech": "npx --yes esbuild scripts/smoke-dynamic-math-speech.ts --bundle --platform=node --external:temml --external:speech-rule-engine --outfile=/tmp/smoke-dynamic-math-speech.js && node /tmp/smoke-dynamic-math-speech.js",
    "ingest:physics": "npx --yes esbuild scripts/ingest-physics-rag.ts --bundle --platform=node --outfile=/tmp/ingest-physics.js && node /tmp/ingest-physics.js",
    "smoke:browser-experience": "npx --yes esbuild scripts/smoke-browser-experience.ts --bundle --platform=node --outfile=/tmp/smoke-browser-experience.js && node /tmp/smoke-browser-experience.js",
    "smoke:explain-video": "npx --yes esbuild scripts/smoke-explain-video.ts --bundle --platform=node --outfile=/tmp/smoke-explain-video.js && node /tmp/smoke-explain-video.js",
    "smoke:tutor-sync": "npx --yes esbuild scripts/smoke-tutor-sync.ts --bundle --platform=node --outfile=/tmp/smoke-tutor-sync.js && node /tmp/smoke-tutor-sync.js",
    "smoke:scene-explain": "npx --yes esbuild scripts/smoke-scene-explain.ts --bundle --platform=node --outfile=/tmp/smoke-scene.js && node /tmp/smoke-scene.js",
    "smoke:grounding": "npx --yes esbuild scripts/smoke-grounding.ts --bundle --platform=node --outfile=/tmp/smoke-grounding.js && node /tmp/smoke-grounding.js",
    "smoke:generated-visual": "npx --yes esbuild scripts/smoke-generated-visual.ts --bundle --platform=node --outfile=/tmp/smoke-generated-visual.js && node /tmp/smoke-generated-visual.js",
    "smoke:pipeline-status": "npx --yes esbuild scripts/smoke-pipeline-status.ts --bundle --platform=node --outfile=/tmp/smoke-pipeline-status.js && node /tmp/smoke-pipeline-status.js",
    "smoke:topics": "npx --yes esbuild scripts/smoke-topics.ts --bundle --platform=node --outfile=/tmp/smoke-topics.js && node /tmp/smoke-topics.js",
    "smoke:token-compression": "npx --yes esbuild scripts/smoke-token-compression.ts --bundle --platform=node --outfile=/tmp/smoke-token-compression.js && node /tmp/smoke-token-compression.js",
    "eval:token-compression-gold": "npx --yes esbuild scripts/eval-token-compression-gold.ts --bundle --platform=node --outfile=/tmp/eval-token-compression-gold.js && node --env-file=.env.local /tmp/eval-token-compression-gold.js"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.21.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@iconify-json/tabler": "^1.2.37",
    "@iconify/utils": "^3.1.4",
    "@seethrough/debug": "file:packages/debug",
    "@supabase/supabase-js": "^2.110.8",
    "@tldraw/driver": "^5.2.5",
    "@tldraw/mermaid": "^5.2.5",
    "@xstate/react": "^6.1.0",
    "@xyflow/react": "^12.12.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.0",
    "gsap": "^3.15.0",
    "jsxgraph": "^1.13.2",
    "jszip": "^3.10.2",
    "katex": "^0.18.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.31.0",
    "mafs": "^0.21.0",
    "mediabunny": "^1.60.0",
    "next": "16.2.12",
    "openai": "^6.49.0",
    "path2d-polyfill": "^3.2.2",
    "playwright-core": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.5",
    "roughjs": "^4.6.6",
    "sanitize-html": "^2.17.7",
    "shadcn": "^4.18.0",
    "speech-rule-engine": "^5.0.0-rc.4",
    "tailwind-merge": "^3.6.0",
    "temml": "^0.14.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "tldraw": "^5.2.5",
    "ts-morph": "^28.0.0",
    "tw-animate-css": "^1.4.0",
    "vivus": "^0.4.6",
    "xstate": "^5.32.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.185.3",
    "@types/vivus": "^0.4.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
